# Legacy in-place upgrade only; new installations use gateway.logrotate.
/var/lib/w103d-gateway/access.log /var/lib/w103d-gateway/error.log {
    daily
    maxsize 10M
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    dateext
    su root root
    create 0600 root root
    sharedscripts
    postrotate
        if /usr/bin/systemctl is-active --quiet w103d-gateway-proxy.service; then
            /usr/bin/systemctl kill --kill-whom=main --signal=USR1 w103d-gateway-proxy.service >/dev/null 2>&1 || true
        fi
    endscript
}
