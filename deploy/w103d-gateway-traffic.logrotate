# Managed by W103D Gateway: traffic logging.
# Legacy in-place upgrade only; new installations use gateway-traffic.logrotate.
# maxsize is checked when logrotate runs; it is not a hard real-time size cap.
/var/lib/w103d-gateway/traffic.log {
    daily
    maxsize 10M
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    dateext
    dateformat -%Y%m%d-%H%M%S
    su root root
    create 0600 root root
    sharedscripts
    postrotate
        if /usr/bin/systemctl is-active --quiet w103d-gateway-proxy.service; then
            /usr/bin/systemctl kill --kill-whom=main --signal=USR1 w103d-gateway-proxy.service >/dev/null 2>&1 || true
        fi
    endscript
}
