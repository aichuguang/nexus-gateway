# Legacy in-place upgrade only; new installations use gateway-proxy.service.
[Unit]
Description=W103D Gateway public entry data plane (isolated Nginx)
Wants=network-online.target
After=network-online.target easytier@default.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/default/w103d-gateway
ExecStartPre=/opt/w103d-gateway/w103d-gateway render --listen ${MANAGEMENT_LISTEN} --gateway-ip ${GATEWAY_IP} --certd-url ${CERTD_URL} --data-dir ${DATA_DIR} --nginx ${NGINX_BIN}
ExecStart=/usr/sbin/nginx -c /var/lib/w103d-gateway/managed-nginx.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -c /var/lib/w103d-gateway/managed-nginx.conf -s reload
KillSignal=SIGQUIT
KillMode=mixed
TimeoutStopSec=30s
Restart=on-failure
RestartSec=5s
UMask=0077
# Nginx starts as root and drops workers to www-data using the config's
# `user` directive. NoNewPrivileges blocks that required setuid transition.
# Keep the remaining filesystem, address-family and private-data restrictions.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/w103d-gateway /var/cache/w103d-gateway
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
