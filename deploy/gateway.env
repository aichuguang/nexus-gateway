# Required: set GATEWAY_IP to this host's assigned VPN IPv4 address.
# No subnet is hardcoded; 10.20.0.9 is only an example, not a default.
# MANAGEMENT_LISTEN accepts that address or 127.0.0.1, on port 18080.
# install.sh writes GATEWAY_IP:18080 unless MANAGEMENT_LISTEN is supplied.
# EnvironmentFile does not expand variables; use a literal address here.
MANAGEMENT_LISTEN=127.0.0.1:18080
GATEWAY_IP=
# Optional user-owned certd endpoint for diagnostics; SSH deployment does not require it.
CERTD_URL=
DATA_DIR=/var/lib/gateway
NGINX_BIN=/usr/sbin/nginx
